local teleportToggle = false
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.O then
        teleportToggle = not teleportToggle
        print("Teleporte " .. (teleportToggle and "Ativado" or "Desativado"))
    elseif input.KeyCode == Enum.KeyCode.T and teleportToggle then
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(0, 50, 0)) -- Posição de destino
        end
    end
end)
